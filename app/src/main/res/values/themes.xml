<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this theme only has to hand it a window that
         doesn't fight it. The bars are transparent and the window background is
         the app's own ground, so the UI runs edge to edge instead of sitting in
         a framed box. -->
    <style name="Theme.BeOffline" parent="android:Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/bo_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Paper ground - dark icons in both bars. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
