<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: an open ring with a bead resting in the gap.
  Clay (AccentPrimary) on the paper background layer.

  The ring is deliberately NOT closed. The product's whole position is that it
  is not a cage - you can always step out, it is just made visible when you do -
  and a broken loop says that where a padlock would say the opposite.

  This layer holds the MARK ONLY. The previous icon baked a whole rounded-square
  app tile, background included, into the foreground, so a circular launcher
  mask showed a square floating inside a circle.

  Sized for the adaptive safe zone: the artwork spans 53 of the 108 viewport,
  well inside the 66 the launcher guarantees to keep.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      The whole mark is rotated 35 degrees. Drawn upright, a gapped ring with a
      dot above it is a power symbol, and reading as the system on/off button is
      the one association this icon cannot afford. Off the vertical, it is a
      loop with something out of it.
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="35">

        <!-- The open ring: a 280 degree arc. -->
        <path
            android:pathData="M68.14,37.15 A22,22 0 1 1 39.86,37.15"
            android:strokeColor="#A8452A"
            android:strokeWidth="9"
            android:strokeLineCap="round" />

        <!-- The bead that has come loose, lifted clear of the ring. -->
        <path
            android:pathData="M49.5,26.5 A4.5,4.5 0 1 1 58.5,26.5 A4.5,4.5 0 1 1 49.5,26.5 Z"
            android:fillColor="#A8452A" />
    </group>
</vector>
